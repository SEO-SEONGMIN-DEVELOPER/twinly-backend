        <mxCell id="n1" value="1. 기본 정보 입력&lt;br&gt;&lt;font color=&quot;#7B8A99&quot; style=&quot;font-size:13px&quot;&gt;학교 · 학과 · 이름 · 생일&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#232F3E;fontSize=18;fontStyle=1;" vertex="1" parent="1">

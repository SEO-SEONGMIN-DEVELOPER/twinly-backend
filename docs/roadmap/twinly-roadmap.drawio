        <mxCell id="mkSub" value="오픈 시점부터&lt;br&gt;상시 가동" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontColor=#5C8F87;" vertex="1" parent="1">

        <mxCell id="mk3" value="인플루언서 협업" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6FAFA6;fontColor=#276158;fontSize=19;" vertex="1" parent="1">

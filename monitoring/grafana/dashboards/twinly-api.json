{
  "uid": "twinly-api",
  "title": "Twinly API",
  "tags": ["twinly"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "서버",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up{job=\"twinly-api\"}, node)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": ["All"],
          "value": ["$__all"]
        },
        "sort": 1
      },
      {
        "name": "caller",
        "label": "호출 주체",
        "type": "custom",
        "query": "앱 : app,외부 서비스 (NICE·RevenueCat) : external,AI 서버 : ai,운영자 : admin,그 외 (봇·없는 경로) : other",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": ["All"],
          "value": ["$__all"]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "초당 요청 수",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^api-a$" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^api-c$" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (node) (rate(http_server_requests_seconds_count{node=~\"$node\", caller=~\"$caller\"}[$__rate_interval]))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "응답시간 p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 0 }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^api-a$" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^api-c$" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (node, le) (rate(http_server_requests_seconds_bucket{node=~\"$node\", caller=~\"$caller\"}[$__rate_interval])))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "에러율 (5xx)",
      "description": "전체 요청 중 서버 오류(5xx) 비율. 4xx는 클라이언트 잘못이라 제외한다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^api-a$" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^api-c$" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (node) (rate(http_server_requests_seconds_count{node=~\"$node\", caller=~\"$caller\", outcome=\"SERVER_ERROR\"}[$__rate_interval]) or (rate(http_server_requests_seconds_count{node=~\"$node\", caller=~\"$caller\"}[$__rate_interval]) * 0)) / sum by (node) (rate(http_server_requests_seconds_count{node=~\"$node\", caller=~\"$caller\"}[$__rate_interval]))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "DB 커넥션",
      "description": "대기가 0보다 크면 커넥션 풀이 고갈된 상태다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "fillOpacity": 0 }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^api-a 사용 중$" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^api-c 사용 중$" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*대기$" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^api-c 대기$" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*최대$" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [4, 4] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (node) (hikaricp_connections_active{node=~\"$node\"})",
          "legendFormat": "{{node}} 사용 중"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (node) (hikaricp_connections_pending{node=~\"$node\"})",
          "legendFormat": "{{node}} 대기"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (node) (hikaricp_connections_max{node=~\"$node\"})",
          "legendFormat": "{{node}} 최대"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "힙 사용률",
      "description": "jvm_memory_max_bytes 는 일부 영역이 -1 이라 max(... > 0) 으로 실제 상한만 고른다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 10,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^api-a$" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^api-c$" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (node) (jvm_memory_used_bytes{node=~\"$node\", area=\"heap\"}) / max by (node) (jvm_memory_max_bytes{node=~\"$node\", area=\"heap\"} > 0)",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU 사용률",
      "description": "서버 전체는 호스트의 모든 프로세스, JVM 은 앱 프로세스만의 사용률이며 둘 다 전체 vCPU 합 기준이다. 두 선의 간격은 앱 밖의 프로세스 몫이다. stage api-a 는 Prometheus·Grafana 가 함께 떠 있어 평소에도 간격이 있다. 0.2 선은 t4g 의 기준 성능(vCPU 당 20%)으로, 이를 넘는 동안 CPU 크레딧이 소모된다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 10,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.2 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^api-a " },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^api-c " },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": " JVM$" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (node) (system_cpu_usage{node=~\"$node\"})",
          "legendFormat": "{{node}} 서버 전체"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (node) (process_cpu_usage{node=~\"$node\"})",
          "legendFormat": "{{node}} JVM"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "서버 생존",
      "description": "Prometheus 가 스크래핑에 성공하면 1, 실패하면 0.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "index": 0 },
                "1": { "text": "UP", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"twinly-api\", node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "호출 주체별 초당 요청 수",
      "description": "요청 경로로 호출 주체를 나눈다. 앱은 /api·/ws, 외부 서비스는 RevenueCat 웹훅과 NICE 리다이렉트, AI 서버는 /internal, 운영자는 /admin, 그 외는 어디에도 해당하지 않는 경로(봇)다. 분류 규칙은 서버의 CallerTaggingObservationConvention 에 있다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "app" }, "properties": [{ "id": "displayName", "value": "앱" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "external" }, "properties": [{ "id": "displayName", "value": "외부 서비스 (NICE·RevenueCat)" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "ai" }, "properties": [{ "id": "displayName", "value": "AI 서버" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }] },
          { "matcher": { "id": "byName", "options": "admin" }, "properties": [{ "id": "displayName", "value": "운영자" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "other" }, "properties": [{ "id": "displayName", "value": "그 외 (봇·없는 경로)" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (caller) (rate(http_server_requests_seconds_count{node=~\"$node\", caller=~\"$caller\", caller!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{caller}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "호출 주체별 요청 (선택 기간)",
      "description": "오른쪽 위에서 고른 기간 동안의 호출 주체별 요청 수와 서버 오류(5xx) 비율. caller 태그를 붙인 배포 이전 기간은 비어 있다.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "호출 주체" },
            "properties": [{ "id": "mappings", "value": [
              {
                "type": "value",
                "options": {
                  "app": { "text": "앱", "index": 0 },
                  "external": { "text": "외부 서비스 (NICE·RevenueCat)", "index": 1 },
                  "ai": { "text": "AI 서버", "index": 2 },
                  "admin": { "text": "운영자", "index": 3 },
                  "other": { "text": "그 외 (봇·없는 경로)", "index": 4 }
                }
              }
            ] }]
          },
          {
            "matcher": { "id": "byName", "options": "요청 수 (기간 합계)" },
            "properties": [
              { "id": "unit", "value": "locale" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "에러율 (5xx)" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "요청 수 (기간 합계)", "desc": true }]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "caller": "호출 주체",
              "Value #A": "요청 수 (기간 합계)",
              "Value #B": "에러율 (5xx)"
            },
            "indexByName": { "caller": 0, "Value #A": 1, "Value #B": 2 }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (caller) (increase(http_server_requests_seconds_count{node=~\"$node\", caller=~\"$caller\", caller!=\"\"}[$__range])) > 0",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum by (caller) (increase(http_server_requests_seconds_count{node=~\"$node\", caller=~\"$caller\", caller!=\"\", outcome=\"SERVER_ERROR\"}[$__range])) or sum by (caller) (increase(http_server_requests_seconds_count{node=~\"$node\", caller=~\"$caller\", caller!=\"\"}[$__range])) * 0) / (sum by (caller) (increase(http_server_requests_seconds_count{node=~\"$node\", caller=~\"$caller\", caller!=\"\"}[$__range])) > 0)",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "API별 트래픽·응답 시간 (선택 기간)",
      "description": "오른쪽 위에서 고른 기간 동안 요청이 있었던 API. 요청 수는 기간 합계, 초당 요청 수와 응답 시간은 기간 기준이다. p95·p99 는 히스토그램 구간을 보간한 근사값이라 호출 수가 적은 API 는 최댓값에 가깝게 나온다. 히스토그램 상한(30초)을 넘는 요청은 30초로 눌려 보인다. Prometheus 보관 기간(15일)보다 긴 기간은 15일치만 반영된다.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "요청 수 (기간 합계)" },
            "properties": [
              { "id": "unit", "value": "locale" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 140 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "평균 초당 요청 수" },
            "properties": [
              { "id": "unit", "value": "reqps" },
              { "id": "decimals", "value": 3 },
              { "id": "custom.width", "value": 140 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^(평균 응답 시간|p95|p99)$" },
            "properties": [
              { "id": "unit", "value": "s" },

            "type": "mysql",
            "uid": "mysql"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COUNT(DISTINCT e.user_id) AS `유료 유저` FROM user_entitlements e WHERE (e.expires_at IS NULL OR e.expires_at > UTC_TIMESTAMP(6)) AND EXISTS (SELECT 1 FROM revenue_cat_events r WHERE r.user_id = e.user_id AND r.environment = 'PRODUCTION')"
        }

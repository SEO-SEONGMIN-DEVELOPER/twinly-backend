{
  "name": "twinly-stage-github-actions-role",
  "description": "",
  "trust": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "Federated": "arn:aws:iam::968177690717:oidc-provider/token.actions.githubusercontent.com"
        },
        "Action": "sts:AssumeRoleWithWebIdentity",
        "Condition": {
          "StringEquals": {
            "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
          },
          "StringLike": {
            "token.actions.githubusercontent.com:sub": [
              "repo:SEO-SEONGMIN-DEVELOPER/twinly-backend:ref:refs/heads/main",
              "repo:SEO-SEONGMIN-DEVELOPER/twinly-backend:ref:refs/heads/main"
            ]
          }
        }
      }
    ]
  },
  "managedPolicies": [
    "TwinlySSMDeploy",
    "TwinlyECRPush"
  ],
  "inlinePolicies": []
}

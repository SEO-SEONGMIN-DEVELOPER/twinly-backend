{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::twinly-media-stage/*"
        },
        {
            "Effect": "Allow",
            "Action": "s3:DeleteObject",
            "Resource": [
                "arn:aws:s3:::twinly-media-stage/student-id/*",
                "arn:aws:s3:::twinly-media-stage/profile/*",
                "arn:aws:s3:::twinly-media-stage/background/*"
            ]
        },
        {
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::twinly-media-stage"
        }
    ]
}
